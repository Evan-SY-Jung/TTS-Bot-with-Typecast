{
  "name": "tts-bot-with-typecast",
  "version": "2.0.0",
  "private": true,
  "description": "채팅을 Typecast 음성으로 읽어 주는 Discord TTS 봇",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "deploy-commands": "node --env-file-if-exists=.env src/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@neosapience/typecast-js": "^0.5.0",
    "discord.js": "^14.28.1",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
