# 이 파일을 .env 로 복사한 뒤 값을 채웁니다.

# ── Discord ─────────────────────────────────────────────
# 봇 토큰. 쉼표로 여러 개를 넣으면 한 서버에서 음성 채널 여러 곳을 동시에 쓸 수 있습니다.
# 앞에 적은 봇이 먼저 쓰입니다.
DISCORD_BOT_TOKENS=

# 비워 두면 봇이 들어가 있는 모든 서버에서 동작합니다.
# 서버 ID를 쉼표로 적으면 그 서버에서만 동작합니다(Typecast 크레딧 보호용).
ALLOWED_GUILD_IDS=

# ── Typecast ────────────────────────────────────────────
# https://typecast.ai/developers
TYPECAST_API_KEY=

# auto | ssfm-v21 | ssfm-v30 | ssfm-v31  (auto: v30, 안 되면 v21)
TYPECAST_MODEL=auto
# ISO 639-3 언어 코드(예: kor). 비우면 자동 감지
TYPECAST_LANGUAGE=
# mp3 | wav
TYPECAST_AUDIO_FORMAT=mp3

# 목소리별 Typecast voice_id. 목소리 목록은 config/voices.json 에 있습니다.
# voices.json 에 voiceId 를 직접 적은 목소리는 여기에 없어도 됩니다.
TYPECAST_VOICE_ABONG=
TYPECAST_VOICE_ASMR=
TYPECAST_VOICE_DUKCHAN=
TYPECAST_VOICE_CHANGU=
TYPECAST_VOICE_CHANGSU=
TYPECAST_VOICE_LETTER=
TYPECAST_VOICE_KIRI=
TYPECAST_VOICE_SUKHEE=

# ── TTS ─────────────────────────────────────────────────
# 기본 목소리 키. 비우면 voices.json 의 첫 번째 목소리
DEFAULT_TTS_VOICE=abong
# 메시지 하나에서 읽는 최대 글자 수. 넘는 부분은 읽지 않습니다.
TTS_MAX_CHARS=200

# ── 저장 위치 (보통 바꿀 필요 없음) ─────────────────────
# DATABASE_PATH=data/ttsbot.db
# VOICES_PATH=config/voices.json
